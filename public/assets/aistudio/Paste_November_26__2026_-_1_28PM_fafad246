    localStorage.setItem('fdoc_wm_loc', S.wmLoc);
  }
  document.getElementById('lst').hidden = true;
  sync();
};

document.getElementById('dt').onchange = e => { S.date = e.target.value || today(); sync(); };

document.getElementById('sheets').onclick = async e => {
  const b = e.target.closest('button[data-a]');
  if (!b || b.disabled) return;
  tgt = +b.dataset.i;
  const a = b.dataset.a;
  if (a === 'cam') document.getElementById('fc').click();
  else if (a === 'gal') document.getElementById('fg').click();
  else if (a === 'rem') {
    if (S.slots.length <= 1) { toast('Minimal harus ada 1 slot foto.', true); return; }
    if (await ask(`Hapus Slot Foto #${tgt + 1} beserta isinya?`)) {
      S.slots.splice(tgt, 1);
      render();
      toast('✔ Slot foto berhasil dihapus.');
    }
  } else if (a === 'del') {
    if (await ask(`Hapus gambar pada Foto #${tgt + 1}?`)) {
      S.slots[tgt].img = '';
      render();
      toast('✔ Foto berhasil dihapus.');
    }
  }
};

document.getElementById('sheets').oninput = e => {
  if (e.target.tagName === 'TEXTAREA') {
    S.slots[e.target.dataset.i].desc = e.target.value;
    if (S.title.trim()) {
      StorageEngine.saveReport(S).catch(() => {});
    }
  }
};

async function got(e) {
  const f = e.target.files[0];
  e.target.value = '';
  if (!f) return;
  toast('⏳ Memproses foto & mencetak watermark lokasi...');
  try {
    S.slots[tgt].img = await shrink(f, S);
    render();
    if (S.title.trim()) {
      await saveReportData();
    }
    toast('✔ Foto berhasil dimasukkan & tersimpan otomatis.');
  } catch (x) {
    toast('Gagal membaca/mengolah foto.', true);
  }
}
document.getElementById('fc').onchange = got;
document.getElementById('fg').onchange = got;

document.getElementById('addp').onclick = () => {
  S.slots.push(blank());
  render();
  toast('✔ 1 slot foto baru ditambahkan.');
};

document.getElementById('newb').onclick = async () => {
  if ((S.title || S.slots.some(s => s.img || s.desc)) && !await ask('Mulai lembar kerja baru?')) return;
  S = fresh();
  document.getElementById('org-in').value = S.org;
  document.getElementById('site-in').value = S.site;
  document.getElementById('q').value = '';
  document.getElementById('dt').value = S.date;
  wmOnChk.checked = S.wmOn;
  wmLocIn.value = S.wmLoc;
  wmGpsIn.value = S.wmGps;
  document.getElementById('edb').hidden = true;
  render();
  toast('✔ Lembar kerja telah di-reset.');
};

document.querySelectorAll('[data-go]').forEach(b => b.onclick = () => {
  const el = document.querySelector(b.dataset.go);
  if (el) el.scrollIntoView({ behavior: 'smooth' });
});

document.getElementById('aq').oninput = renderArchiveTable;
document.getElementById('ref').onclick = () => { loadArchiveView(); toast('✔ Arsip diperbarui.'); };

document.getElementById('rows').onclick = async e => {
  const bEdit = e.target.closest('button[data-e]');
  const bDel = e.target.closest('button[data-d]');

  if (bEdit) {
    const targetId = String(bEdit.dataset.e);
    const r = archiveCache.find(x => String(x.id) === targetId);
    if (!r) return;
    S = JSON.parse(JSON.stringify(r));
    if (!S.org) S.org = getSavedOrgHeader();
    if (!S.site) S.site = getSitePrefix();
    if (S.wmOn === undefined) S.wmOn = true;
    if (!S.wmLoc) S.wmLoc = localStorage.getItem('fdoc_wm_loc') || 'Area Fasilitas Utama';
    if (!S.wmGps) S.wmGps = getInitialGpsString();
    document.getElementById('org-in').value = S.org;
    document.getElementById('site-in').value = S.site;
    document.getElementById('q').value = S.title;
    document.getElementById('dt').value = S.date;
    wmOnChk.checked = S.wmOn;
    wmLocIn.value = S.wmLoc;
    wmGpsIn.value = S.wmGps;
    document.getElementById('edb').hidden = false;
    tab(1);
    render();
    toast('✔ Laporan berhasil dimuat.');
  } else if (bDel) {
    const reportId = String(bDel.dataset.d);
    const r = archiveCache.find(x => String(x.id) === reportId);
    const label = r && r.title ? r.title : 'Tanpa Judul';
    if (await ask(`Hapus laporan "${label}" dari Arsip?`)) {
      await deleteReportData(reportId);
      if (String(S.id) === reportId) {
        S.id = null;
        document.getElementById('edb').hidden = true;
      }
      toast('✔ Laporan berhasil dihapus.');
    }
  }
};

document.getElementById('bw').onclick = () => exportAs('docx');
document.getElementById('bp').onclick = () => exportAs('pdf');

const bsBtn = document.getElementById('bs');
if (bsBtn) {
  bsBtn.onclick = async function () {
    if (busy) return;
    if (!S.title.trim()) {
      toast('Harap isi judul pekerjaan terlebih dahulu.', true);
      document.getElementById('q').focus();
      return;
    }
    busy = true;
    this.disabled = true;
    const oldText = this.textContent;
    this.textContent = '⏳ Menyimpan...';
    try {
      await saveReportData();
      toast('✔ Laporan berhasil disimpan ke Arsip & disinkronkan!');
    } catch (e) {
      toast('Gagal menyimpan laporan.', true);
    } finally {
      this.textContent = oldText;
      this.disabled = false;
      busy = false;
    }
  };
}

// Auto-upload when connection returns
