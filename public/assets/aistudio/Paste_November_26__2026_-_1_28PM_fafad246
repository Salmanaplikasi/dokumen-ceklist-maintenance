document.getElementById('cf-save').onclick = async () => {
  const apiKey = document.getElementById('cf-apikey').value.trim();
  const projectId = document.getElementById('cf-projid').value.trim();
  const room = document.getElementById('cf-room').value.trim() || 'tim_fasilitas_1';
  const consent = document.getElementById('cf-consent').checked;

  if (!apiKey || !projectId) {
    toast('Harap isi Firebase API Key dan Project ID.', true);
    return;
  }
  if (!consent) {
    toast('Harap centang persetujuan sinkronisasi data.', true);
    return;
  }

  localStorage.setItem('fdoc_private_cloud_cfg', JSON.stringify({ apiKey, projectId, room, consent }));
  document.getElementById('cloud-mod').hidden = true;
  const ok = await initPrivateFirebaseConnection(onCloudDataUpdate);
  if (ok) {
    await loadArchiveView();
    toast('☁️ Terhubung ke Cloud Firebase Privat Tim!');
  } else {
    toast('Gagal menghubungkan ke Firebase.', true);
  }
};

document.getElementById('cf-share-link').onclick = () => {
  const apiKey = document.getElementById('cf-apikey').value.trim();
  const projectId = document.getElementById('cf-projid').value.trim();
  const room = document.getElementById('cf-room').value.trim() || 'tim_fasilitas_1';
  if (!apiKey || !projectId) {
    toast('Isi API Key & Project ID terlebih dahulu.', true);
    return;
  }
  const encoded = btoa(JSON.stringify({ apiKey, projectId, room }));
  const shareUrl = window.location.origin + window.location.pathname + '?cloud_cfg=' + encodeURIComponent(encoded);
  navigator.clipboard.writeText(shareUrl).then(() => {
    toast('🔗 Link Auto-Connect berhasil disalin!');
  }).catch(() => {
    prompt('Salin link Auto-Connect ini:', shareUrl);
  });
};

