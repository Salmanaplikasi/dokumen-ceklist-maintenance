rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'salmanabdurrohman21@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidReportData(data, reportId) {
      return data.keys().hasAll([
        'id', 'ownerUid', 'visibility', 'org', 'site', 'title', 'date',
        'wmOn', 'wmLoc', 'wmGps', 'author', 'roleLabel',
        'slotCount', 'filledCount', 'clientUpdatedMs', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'ownerUid', 'visibility', 'org', 'site', 'title', 'date',
        'wmOn', 'wmLoc', 'wmGps', 'author', 'roleLabel',
        'slotCount', 'filledCount', 'clientUpdatedMs', 'createdAt', 'updatedAt'
      ])
      && data.id == reportId
      && isValidId(data.id)
      && isValidId(data.ownerUid)
      && (data.visibility == 'team' || data.visibility == 'private')
      && data.org is string && data.org.size() >= 1 && data.org.size() <= 200
      && data.site is string && data.site.size() <= 64
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 250
      && data.date is string && data.date.size() >= 1 && data.date.size() <= 32
      && data.wmOn is bool
      && data.wmLoc is string && data.wmLoc.size() <= 200
      && data.wmGps is string && data.wmGps.size() <= 160
      && data.author is string && data.author.size() >= 1 && data.author.size() <= 120
      && data.roleLabel is string && data.roleLabel.size() <= 120
      && data.slotCount is int && data.slotCount >= 1 && data.slotCount <= 50
      && data.filledCount is int && data.filledCount >= 0 && data.filledCount <= 50
      && data.clientUpdatedMs is number && data.clientUpdatedMs >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSlotData(data, reportId) {
      return data.keys().hasAll([
        'reportId', 'ownerUid', 'visibility', 'slotIndex', 'img', 'desc', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'reportId', 'ownerUid', 'visibility', 'slotIndex', 'img', 'desc', 'createdAt', 'updatedAt'
      ])
      && data.reportId == reportId
      && isValidId(data.reportId)
      && isValidId(data.ownerUid)
      && (data.visibility == 'team' || data.visibility == 'private')
      && data.slotIndex is int && data.slotIndex >= 0 && data.slotIndex < 50
      && data.img is string && data.img.size() <= 450000
      && data.desc is string && data.desc.size() <= 4000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'roleLabel', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'displayName', 'email', 'roleLabel', 'updatedAt'])
      && data.uid == userId
      && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.email is string && data.email.size() <= 200
      && data.roleLabel is string && data.roleLabel.size() <= 120
      && data.updatedAt is timestamp;
    }

    // 3. Startup Connection Health Check Document
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
    }

    // 4. Admin Membership Registry (Read-only for self/admin)
    match /admins/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // 5. Private User PII Profiles (Isolated per user)
    match /users/{userId}/private/{docId} {
      allow get: if isVerified() && isValidId(userId) && isValidId(docId) && (request.auth.uid == userId || isAdmin());
      allow create: if isVerified()
        && isValidId(userId)
        && isValidId(docId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isValidId(docId)
        && (request.auth.uid == userId || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'roleLabel', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && isValidId(docId) && (request.auth.uid == userId || isAdmin());
    }

    // 6. FieldDoc Reports Collection (Shared Team Archive + Private Drafts)
    match /fielddoc_reports/{reportId} {
      allow get: if isVerified() && isValidId(reportId) && (
        existing().visibility == 'team' ||
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isVerified() && (
        resource.data.visibility == 'team' ||
        resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isVerified()
        && isValidId(reportId)
        && isValidReportData(incoming(), reportId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(reportId)
        && isValidReportData(incoming(), reportId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            (existing().ownerUid == request.auth.uid || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'visibility', 'org', 'site', 'title', 'date',
              'wmOn', 'wmLoc', 'wmGps', 'author', 'roleLabel',
              'slotCount', 'filledCount', 'clientUpdatedMs', 'updatedAt'
            ])
          )
          ||
          (
            existing().visibility == 'team'
            && incoming().visibility == existing().visibility
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'org', 'site', 'title', 'date',
              'wmOn', 'wmLoc', 'wmGps', 'author', 'roleLabel',
              'slotCount', 'filledCount', 'clientUpdatedMs', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerified() && isValidId(reportId) && (
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );

      // 7. Photo Slots Subcollection (Master Gate checks parent /fielddoc_reports/{reportId})
      match /slots/{slotId} {
        allow get: if isVerified()
          && isValidId(reportId)
          && isValidId(slotId)
          && exists(/databases/$(database)/documents/fielddoc_reports/$(reportId))
          && (
            get(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.visibility == 'team' ||
            get(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.ownerUid == request.auth.uid ||
            isAdmin()
          );

        allow list: if isVerified() && (
          resource.data.visibility == 'team' ||
          resource.data.ownerUid == request.auth.uid ||
          isAdmin()
        );

        allow create: if isVerified()
          && isValidId(reportId)
          && isValidId(slotId)
          && isValidSlotData(incoming(), reportId)
          && existsAfter(/databases/$(database)/documents/fielddoc_reports/$(reportId))
          && getAfter(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.ownerUid == incoming().ownerUid
          && getAfter(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.visibility == incoming().visibility
          && (
            getAfter(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.ownerUid == request.auth.uid ||
            getAfter(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.visibility == 'team' ||
            isAdmin()
          )
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(reportId)
          && isValidId(slotId)
          && isValidSlotData(incoming(), reportId)
          && exists(/databases/$(database)/documents/fielddoc_reports/$(reportId))
          && (
            get(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.visibility == 'team' ||
            isAdmin()
          )
          && incoming().reportId == existing().reportId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'slotIndex', 'img', 'desc', 'visibility', 'updatedAt'
          ]);

        allow delete: if isVerified()
          && isValidId(reportId)
          && isValidId(slotId)
          && exists(/databases/$(database)/documents/fielddoc_reports/$(reportId))
          && (
            get(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/fielddoc_reports/$(reportId)).data.visibility == 'team' ||
            isAdmin()
          );
      }
    }
  }
}
