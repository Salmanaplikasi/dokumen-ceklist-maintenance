function tab(n) {
  document.getElementById('wrk').hidden = n !== 1;
  document.getElementById('arc').hidden = n !== 2;
  document.getElementById('t1').classList.toggle('on', n === 1);
  document.getElementById('t2').classList.toggle('on', n === 2);
  if (n === 2) loadArchiveView();
  window.scrollTo(0, 0);
}

