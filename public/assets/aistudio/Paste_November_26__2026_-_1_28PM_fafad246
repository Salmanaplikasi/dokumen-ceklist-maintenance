async function saveReportData() {
  S.author = getEngineerName();
  S.email = getEngineerEmail();
  S.org = (S.org || DEFAULT_ORG).trim() || DEFAULT_ORG;
  localStorage.setItem('fdoc_org_header', S.org);
  await StorageEngine.saveReport(S);
  document.getElementById('edb').hidden = false;
  await loadArchiveView();
}

function renderArchiveTable() {
  const cntEl = document.getElementById('cnt');
  if (cntEl) cntEl.textContent = archiveCache.length;

  const q = document.getElementById('aq').value.toLowerCase().trim();
  const r = archiveCache.filter(x => !q || ((x.org || '') + ' ' + x.title + ' ' + x.date + ' ' + fmt(x.date) + ' ' + (x.author || '') + ' ' + (x.email || '')).toLowerCase().includes(q));

  document.getElementById('rows').innerHTML = r.length ? r.map(x => `
    <tr>
      <td>
        <div style="font-size:10.5px;color:var(--primary);font-weight:800">${esc(x.org || DEFAULT_ORG)}</div>
        <strong style="font-size:13.5px">${esc(x.title || 'Tanpa Judul')}</strong>
      </td>
      <td>${fmt(x.date)}</td>
      <td>
        <div><code>${esc(x.author || 'Teknisi')}</code></div>
        <small style="color:var(--text-muted);font-size:11px">${esc(x.email || '')}</small>
      </td>
      <td><span class="slot-badge">${(x.slots || []).filter(s => s.img).length} Foto</span></td>
      <td class="act">
        <button type="button" class="btn-tbl-edit" data-e="${esc(String(x.id))}">✏️ Edit</button>
        <button type="button" class="btn-tbl-del" data-d="${esc(String(x.id))}">🗑️ Hapus</button>
      </td>
    </tr>`).join('') : `<tr><td colspan="5" class="emp">${archiveCache.length ? 'Tidak ada laporan yang cocok dengan pencarian.' : 'Belum ada laporan tersimpan di dalam Arsip.'}</td></tr>`;
}

async function loadArchiveView() {
  archiveCache = await StorageEngine.getReports(archiveCache);
  renderArchiveTable();
}

async function deleteReportData(id) {
  archiveCache = archiveCache.filter(x => String(x.id) !== String(id));
  await StorageEngine.deleteReport(id);
  await loadArchiveView();
}

function sync() {
  const orgText = (S.org && S.org.trim() !== '') ? S.org : DEFAULT_ORG;
  const orgLbl = document.getElementById('org-lbl');
  if (orgLbl) orgLbl.textContent = orgText;

  const t = document.getElementById('ttl');
  t.textContent = S.title || 'Judul Pekerjaan';
  t.classList.toggle('e', !S.title);

  document.getElementById('dtx').textContent = fmtFullDay(S.date);
  document.querySelectorAll('.m-org').forEach(e => e.textContent = orgText);
  document.querySelectorAll('.m-t').forEach(e => e.textContent = S.title);
  document.querySelectorAll('.m-d').forEach(e => e.textContent = fmtFullDay(S.date));
  updateStatsBar();

  if (S.title.trim()) {
    StorageEngine.saveReport(S).catch(() => {});
  }
}

function list() {
  const ts = document.getElementById('q').value.toLowerCase().split(/\s+/).filter(Boolean);
  const m = ITEMS.filter(o => ts.every(w => o.l.includes(w)));
  const L = document.getElementById('lst');
  L.innerHTML = m.slice(0, 30).map(o => `<li data-i="${ITEMS.indexOf(o)}"><b>${esc(o.n)}</b><small>${esc(o.k)}</small></li>`).join('') +
    (m.length > 30 ? `<li class="mu">+${m.length - 30} unit lainnya…</li>` : '') || '<li class="mu">Ketik judul kustom jika tidak ada di dalam daftar unit.</li>';
  L.hidden = false;
}

function render() {
  const y = window.scrollY;
  document.getElementById('hold').append(document.getElementById('hdr'));
  const np = Math.ceil(S.slots.length / PER);
  let h = '';
  for (let p = 0; p < np; p++) {
    h += `<section class="sheet">` + (p ? `<div class="sheet-hdr"><div><div class="m-org"></div><h2 class="ttl m-t"></h2></div></div><div class="date-formatted m-d" style="margin-bottom:14px;display:block"></div>` : '<div id="slot"></div>') + '<div class="grid">';
    const start = p * PER, end = Math.min(start + PER, S.slots.length);
    for (let i = start; i < end; i++) {
      const s = S.slots[i];
      const numStr = String(i + 1).padStart(2, '0');
      h += `<div class="cell">
        <div class="n">
          <span class="slot-badge">DOK #${numStr}</span>
          <button type="button" class="btn-rem-slot" data-a="rem" data-i="${i}">🗑️ Hapus Slot</button>
        </div>
        <div class="box">` + (s.img ? 
          `<img src="${s.img}" alt="Foto ${i + 1}">
           <div class="ov">
             <button type="button" class="g" data-a="cam" data-i="${i}">📷 Kamera</button>
             <button type="button" class="btn-ov-gal" data-a="gal" data-i="${i}">📁 Galeri</button>
             <button type="button" class="btn-ov-del" data-a="del" data-i="${i}">✕</button>
           </div>` : 
          `<div class="empty-mobile-btn">
             <button type="button" class="btn-m-cam" data-a="cam" data-i="${i}"><span style="font-size:24px">📷</span>Ambil Kamera</button>
             <button type="button" class="btn-m-gal" data-a="gal" data-i="${i}"><span style="font-size:24px">📁</span>Pilih Galeri</button>
           </div>`) + `
        </div>
        <textarea data-i="${i}" placeholder="Tulis deskripsi pekerjaan / temuan teknis foto #${numStr}..." aria-label="Deskripsi foto ${i + 1}">${esc(s.desc)}</textarea>
      </div>`;
    }
    h += `</div><div class="pn">Halaman ${p + 1} dari ${np}</div></section>`;
  }
  document.getElementById('sheets').innerHTML = h;
  document.getElementById('slot').replaceWith(document.getElementById('hdr'));
  sync();
  window.scrollTo(0, y);
}

/* EXPORT TO WORD (.DOCX) & PDF */
const nm = ext => 'Laporan_Dokumentasi_' + (S.title.replace(/[^\w\- ]+/g, '').trim().replace(/\s+/g, '_').slice(0, 40) || 'Teknis') + '_' + S.date + '.' + ext;
const u8 = d => Uint8Array.from(atob(d.split(',')[1]), c => c.charCodeAt(0));

async function give(blob, name) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = name;
  a.style.display = 'none';
  document.body.appendChild(a);
  a.click();
  setTimeout(() => {
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }, 6000);
}

async function buildDocx() {
  const D = window.docx;
  const np = Math.ceil(S.slots.length / PER);
  const kids = [];
  const cellBorder = { style: D.BorderStyle.SINGLE, size: 4, color: 'CBD5E1' };
  const W = 3360;
  const headerOrgText = (S.org || DEFAULT_ORG).trim() || DEFAULT_ORG;
  const authorLine = (S.author || getEngineerName()) + (S.email ? ' (' + S.email + ')' : '');

  const run = (t, o = {}) => new D.TextRun({ text: t, font: 'Calibri', size: 18, color: '0F172A', ...o });
  const runMuted = (t, o = {}) => new D.TextRun({ text: t, font: 'Calibri', size: 16, color: '475569', ...o });

  for (let p = 0; p < np; p++) {
    kids.push(
      new D.Paragraph({
        spacing: { before: p > 0 ? 200 : 0, after: 40 },
        children: [runMuted(headerOrgText, { bold: true, size: 16, color: '1E40AF' })]
      }),
      new D.Paragraph({
        spacing: { after: 60 },
        children: [run(S.title || 'Laporan Dokumentasi Pekerjaan', { bold: true, size: 28, color: '0F172A' })]
      }),
      new D.Paragraph({
        spacing: { after: 140 },
        border: { bottom: { style: D.BorderStyle.SINGLE, size: 12, color: '1E40AF' } },
        children: [
          runMuted('Tanggal: ' + fmtFullDay(S.date) + '   |   Lokasi: ' + (S.wmLoc || '-') + '   |   Pelapor: ' + authorLine)
        ]
      })
    );

    const rows = [];
    const start = p * PER, end = Math.min(start + PER, S.slots.length);
    const pageSlots = S.slots.slice(start, end);
    const rowCount = Math.ceil(pageSlots.length / 3);

    for (let r = 0; r < rowCount; r++) {
      const cells = [];
      for (let c = 0; c < 3; c++) {
        const idx = r * 3 + c;
        const globalIdx = start + idx;
        const s = pageSlots[idx];
        const ch = [];

        if (s) {
          ch.push(new D.Paragraph({
            spacing: { before: 20, after: 60 },
            children: [run('FOTO DOKUMENTASI #' + (globalIdx + 1), { bold: true, size: 15, color: '1E40AF' })]
          }));

          if (s.img) {
            const cv = await cover(s.img, 640, 480);
            ch.push(new D.Paragraph({
              alignment: D.AlignmentType.CENTER,
              spacing: { before: 20, after: 80 },
              children: [new D.ImageRun({
                data: u8(cv.toDataURL('image/jpeg', 0.85)),
                transformation: { width: 172, height: 129 }
              })]
            }));
          } else {
            ch.push(new D.Paragraph({
              alignment: D.AlignmentType.CENTER,
              spacing: { before: 140, after: 140 },
              children: [runMuted('[ Tanpa Foto ]', { italic: true, size: 15 })]
            }));
          }

          const descText = (s.desc || 'Tidak ada catatan deskripsi.').trim();
          descText.split('\n').forEach(line => {
            ch.push(new D.Paragraph({
              spacing: { before: 20, after: 20, line: 240 },
              children: [run(line, { size: 17, color: '1E293B' })]
            }));
          });
        } else {
          ch.push(new D.Paragraph({ children: [run('')] }));
        }

        cells.push(new D.TableCell({
          width: { size: W, type: D.WidthType.DXA },
          margins: { top: 100, bottom: 100, left: 100, right: 100 },
          shading: { fill: s ? 'FFFFFF' : 'F8FAFC' },
          borders: { top: cellBorder, bottom: cellBorder, left: cellBorder, right: cellBorder },
          children: ch
        }));
      }
      rows.push(new D.TableRow({ cantSplit: true, children: cells }));
    }

    kids.push(new D.Table({
      width: { size: W * 3, type: D.WidthType.DXA },
      columnWidths: [W, W, W],
      rows
    }));

    await new Promise(r => setTimeout(r, 15));
  }

  const doc = new D.Document({
    styles: { default: { document: { run: { font: 'Calibri', size: 18 } } } },
    sections: [{
      properties: {
        page: {
          size: { width: 11906, height: 16838 },
          margin: { top: 750, bottom: 750, left: 750, right: 750, footer: 360 }
        }
      },
      footers: {
        default: new D.Footer({
          children: [new D.Paragraph({
            alignment: D.AlignmentType.RIGHT,
            children: [
              runMuted(headerOrgText + '  |  Halaman '),
              new D.TextRun({ children: [D.PageNumber.CURRENT], font: 'Calibri', size: 16, color: '475569' })
            ]
          })]
        })
      },
      children: kids
    }]
  });

  return D.Packer.toBlob(doc);
}

async function buildPdf() {
  const { jsPDF } = window.jspdf;
  const K = 2, PW = 794, PH = 1123, M = 42;
  const np = Math.ceil(S.slots.length / PER);
  const pdf = new jsPDF({ unit: 'mm', format: 'a4', compress: true });
  const headerOrgText = (S.org || DEFAULT_ORG).trim() || DEFAULT_ORG;
  const authorLine = (S.author || getEngineerName()) + (S.email ? ' (' + S.email + ')' : '');

  for (let p = 0; p < np; p++) {
    const c = document.createElement('canvas');
    c.width = PW * K;
    c.height = PH * K;
    const x = c.getContext('2d');
    x.scale(K, K);

    x.fillStyle = '#ffffff';
    x.fillRect(0, 0, PW, PH);

    x.fillStyle = '#1e40af';
    x.fillRect(M, M - 8, PW - 2 * M, 4);

    x.fillStyle = '#1e40af';
    x.font = 'bold 9.5px ' + FF;
    const orgLines = wrapText(x, headerOrgText, PW - 2 * M).slice(0, 1);
    x.fillText(orgLines[0] || headerOrgText, M, M + 10);

    x.fillStyle = '#0f172a';
    x.font = 'bold 16px ' + FF;
    const tl = wrapText(x, S.title || 'Laporan Dokumentasi Pekerjaan', PW - 2 * M).slice(0, 2);
    tl.forEach((l, i) => x.fillText(l, M, M + 30 + i * 20));

    const yMeta = M + 28 + tl.length * 20;
    x.fillStyle = '#f1f5f9';
    x.fillRect(M, yMeta - 11, PW - 2 * M, 20);
    x.strokeStyle = '#cbd5e1';
    x.lineWidth = 0.8;
    x.strokeRect(M, yMeta - 11, PW - 2 * M, 20);

    x.fillStyle = '#334155';
    x.font = 'bold 8.8px ' + FF;
    x.fillText(
      'Tanggal: ' + fmtFullDay(S.date) + '   |   Lokasi: ' + (S.wmLoc || '-') + '   |   Pelapor: ' + authorLine,
      M + 8,
      yMeta + 2
    );

    const gt = yMeta + 20;
    const gap = 8;
    const cw = (PW - 2 * M - gap * 2) / 3;
    const rh = 205;

    const start = p * PER, end = Math.min(start + PER, S.slots.length);
    const pageSlots = S.slots.slice(start, end);
    const rowCount = Math.ceil(pageSlots.length / 3);

    for (let r = 0; r < rowCount; r++) {
      for (let k = 0; k < 3; k++) {
        const idx = r * 3 + k;
        const globalIdx = start + idx;
        const s = pageSlots[idx];
        if (!s) continue;

        const x0 = M + k * (cw + gap);
        const y0 = gt + r * (rh + 10);
        const iw = cw - 12;
        const ih = iw * 0.75;

        x.fillStyle = '#ffffff';
        x.fillRect(x0, y0, cw, rh);
        x.fillStyle = '#eff6ff';
        x.fillRect(x0, y0, cw, 18);
        x.strokeStyle = '#cbd5e1';
        x.lineWidth = 1;
        x.strokeRect(x0, y0, cw, rh);

        x.fillStyle = '#1e40af';
        x.font = 'bold 8.5px ' + FF;
        x.fillText('FOTO DOKUMENTASI #' + (globalIdx + 1), x0 + 6, y0 + 12);

        if (s.img) {
          const cv = await cover(s.img, Math.round(iw * K), Math.round(ih * K));
          x.drawImage(cv, x0 + 6, y0 + 23, iw, ih);
          x.strokeStyle = '#e2e8f0';
          x.strokeRect(x0 + 6, y0 + 23, iw, ih);
        } else {
          x.fillStyle = '#f8fafc';
          x.fillRect(x0 + 6, y0 + 23, iw, ih);
          x.strokeStyle = '#e2e8f0';
          x.strokeRect(x0 + 6, y0 + 23, iw, ih);
          x.fillStyle = '#94a3b8';
          x.font = 'italic 9px ' + FF;
          x.textAlign = 'center';
          x.fillText('[ Tanpa Foto ]', x0 + cw / 2, y0 + 23 + ih / 2 + 3);
          x.textAlign = 'left';
        }

        x.fillStyle = '#1e293b';
        x.font = '9px ' + FF;
        const descY = y0 + 23 + ih + 13;
        const lines = wrapText(x, s.desc || 'Tidak ada catatan deskripsi.', iw - 4).slice(0, 4);
        lines.forEach((l, i) => x.fillText(l, x0 + 6, descY + i * 11.5));
      }
    }

    x.strokeStyle = '#cbd5e1';
    x.lineWidth = 0.8;
    x.beginPath();
    x.moveTo(M, PH - 34);
    x.lineTo(PW - M, PH - 34);
    x.stroke();

    x.fillStyle = '#64748b';
    x.font = '9px ' + FF;
    x.fillText(headerOrgText.slice(0, 75), M, PH - 20);
    x.textAlign = 'right';
    x.fillText('Halaman ' + (p + 1) + ' dari ' + np, PW - M, PH - 20);
    x.textAlign = 'left';

    if (p > 0) pdf.addPage();
    pdf.addImage(c.toDataURL('image/jpeg', 0.88), 'JPEG', 0, 0, 210, 297);
    await new Promise(r => setTimeout(r, 15));
  }
  return pdf.output('blob');
}

async function exportAs(kind) {
  if (busy) return;
  if (!S.title.trim()) {
    toast('Harap isi judul pekerjaan terlebih dahulu.', true);
    document.getElementById('hdr').scrollIntoView({ behavior: 'smooth' });
    document.getElementById('q').focus();
    return;
  }
  if (kind === 'docx' ? !window.docx : !window.jspdf) {
    toast('Library export belum siap, periksa koneksi internet Anda.', true);
    return;
  }

  busy = true;
  const bw = document.getElementById('bw'), bp = document.getElementById('bp'), bs = document.getElementById('bs');
  if (bw) bw.disabled = true;
  if (bp) bp.disabled = true;
  if (bs) bs.disabled = true;

  const b = kind === 'docx' ? bw : bp;
  const oldText = b ? b.textContent : '';
  if (b) b.textContent = '⏳ Membuat File…';

  try {
    try { await saveReportData(); } catch (e) {}
    const blob = await (kind === 'docx' ? buildDocx() : buildPdf());
    await give(blob, nm(kind === 'docx' ? 'docx' : 'pdf'));
    toast('✔ Laporan ' + (kind === 'docx' ? 'Word (.docx)' : 'PDF') + ' berhasil diunduh.');
  } catch (err) {
    console.error(err);
    toast('Gagal membuat file export.', true);
  } finally {
    if (b) b.textContent = oldText;
    if (bw) bw.disabled = false;
    if (bp) bp.disabled = false;
    if (bs) bs.disabled = false;
    busy = false;
  }
}

