  updateGpsStatusUI(S);
  toast('🟢 Terhubung ke internet. Menyinkronkan laporan otomatis...');
  await initPrivateFirebaseConnection(onCloudDataUpdate);
  if (S.title.trim()) {
    await saveReportData();
  }
});

window.addEventListener('offline', () => {
  applyLastKnownFallback(S, true);
  updateGpsStatusUI(S);
});

/* INITIALIZE PORTAL */
(async function initPortal() {
  checkUrlAutoConnectConfig();

  const savedTheme = localStorage.getItem('fdoc_theme') || 'light';
  document.documentElement.setAttribute('data-theme', savedTheme);

  updateEngineerDisplay();
  document.getElementById('org-in').value = S.org;
  document.getElementById('site-in').value = S.site;
  document.getElementById('dt').value = S.date;
  wmOnChk.checked = S.wmOn;
  wmLocIn.value = S.wmLoc;
  wmGpsIn.value = S.wmGps;
  updateGpsStatusUI(S);

  if (!navigator.onLine) {
    applyLastKnownFallback(S, false);
  }

  render();
  await initPrivateFirebaseConnection(onCloudDataUpdate);
  await loadArchiveView();
})();