document.getElementById('q').onfocus = list;
document.getElementById('q').onblur = () => setTimeout(() => document.getElementById('lst').hidden = true, 200);

document.getElementById('lst').onpointerdown = e => {
  e.preventDefault();
  const li = e.target.closest('li[data-i]');
  if (!li) return;
  const item = ITEMS[li.dataset.i];
  S.title = item.t;
